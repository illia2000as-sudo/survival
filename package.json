{
  "name": "my-game",
  "productName": "MyGame",
  "version": "1.0.2",
  "main": "electron-main.js",
  "scripts": { "start": "electron ." },
  "dependencies": { "three": "^0.160.0" },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.mygame",
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.exe"
    }
  }
}
