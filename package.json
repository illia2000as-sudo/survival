{
  "name": "my-game",
  "productName": "DeadZone",
  "version": "1.1.6",
  "main": "electron-main.js",
  "scripts": { "start": "electron ." },
  "dependencies": {
    "peerjs": "^1.5.4",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.deadzone",
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.exe"
    }
  }
}
