{
  "name": "my-game",
  "productName": "DeadZone",
  "version": "1.12.0",
  "description": "DeadZone: постапокалиптическое 3D-выживание с мультиплеером",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron ."
  },
  "dependencies": {
    "three": "^0.160.0",
    "peerjs": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.deadzone",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.exe"
    }
  }
}
